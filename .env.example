# 🔐 Environment Variables Template
# Copy this file to .env and fill with your actual values
# NEVER commit .env to git!

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp
DATABASE_NAME=Agenda_Ai

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Application Configuration
APP_NAME=Agenda IA
APP_VERSION=2.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Security Configuration (Generate secure keys!)
SECRET_KEY=your-86-character-secure-secret-key-here
ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Link Management Configuration
LINK_BASE_URL=https://your-backend-domain.com
DEFAULT_LINK_EXPIRY_HOURS=48
MAX_LINK_EXPIRY_HOURS=168

# Email Configuration - Gmail SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM_NAME=Agenda IA
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_ENABLED=True

# Company Information
COMPANY_NAME=Agenda IA
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=your-email@gmail.com
COMPANY_WEBSITE=https://your-website.com

# WhatsApp Configuration (future use)
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=100